{
  "name": "nitrosense-linux-compat",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Rust Linux backend with the original user-supplied Acer NitroSense frontend",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup:electron": "npm install --prefix .tools/electron-runtime --save-exact --no-audit --no-fund electron@26.6.10",
    "prepare:vendor": "cargo run --manifest-path backend/Cargo.toml -p nitrosense-tools -- import",
    "import": "cargo run --manifest-path backend/Cargo.toml -p nitrosense-tools -- import",
    "check": "cargo run --manifest-path backend/Cargo.toml -p nitrosense-tools -- check-original",
    "start": "sh frontend/start.sh --experimental-runtime",
    "start:acer": "sh scripts/validate-linux-sensors.sh && sh frontend/start.sh --experimental-runtime",
    "verify:readings": "cargo run --manifest-path backend/Cargo.toml -p nitrosense-service --bin nitrosense-backend -- diagnose",
    "test": "cargo test --manifest-path backend/Cargo.toml --locked && node --test frontend/host/*.test.cjs tests/*.test.cjs legacy/tests/*.test.cjs legacy/runtime/*.test.cjs",
    "setup": "cargo run --manifest-path backend/Cargo.toml -p nitrosense-tools -- setup",
    "inspect:original": "cargo run --manifest-path backend/Cargo.toml -p nitrosense-tools -- inspect-original",
    "audit:changes": "cargo run --manifest-path backend/Cargo.toml -p nitrosense-tools -- audit",
    "start:legacy": "sh legacy/scripts/test-linux-readonly.sh",
    "start:acer:legacy": "sh legacy/scripts/test-linux-readonly.sh --with-acer-wmi",
    "check:legacy": "node legacy/scripts/check-runtime.cjs",
    "inspect:original:legacy": "node legacy/scripts/inspect-original.cjs",
    "audit:changes:legacy": "node scripts/audit-reverse-engineering.cjs",
    "import:legacy": "node legacy/scripts/import-vendor.cjs",
    "test:legacy": "node --test legacy/tests/*.test.cjs legacy/runtime/*.test.cjs",
    "test:rust": "cargo test --manifest-path backend/Cargo.toml --locked",
    "test:frontend": "node --test frontend/host/*.test.cjs",
    "checklist": "cargo run --manifest-path backend/Cargo.toml -p nitrosense-tools -- checklist",
    "build": "cargo build --manifest-path backend/Cargo.toml --locked",
    "setup:legacy": "node legacy/scripts/setup.cjs",
    "prepare:vendor:legacy": "node legacy/scripts/prepare-linux-vendor.cjs",
    "verify:readings:legacy": "node legacy/scripts/check-manual-readings.cjs"
  }
}
