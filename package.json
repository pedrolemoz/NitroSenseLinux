{
  "name": "nitrosense-linux-compat",
  "version": "0.1.0",
  "private": true,
  "description": "Compatibility loader for user-supplied Acer NitroSense files",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup:electron": "npm install --prefix .tools/electron-runtime --save-exact --no-audit --no-fund electron@26.6.10",
    "prepare:vendor": "node scripts/prepare-linux-vendor.cjs",
    "import": "node scripts/import-vendor.cjs",
    "check": "node scripts/check-runtime.cjs",
    "start": "sh scripts/test-linux-readonly.sh",
    "start:acer": "sh scripts/test-linux-readonly.sh --with-acer-wmi",
    "verify:readings": "node scripts/check-manual-readings.cjs",
    "test": "node --test tests/*.test.cjs runtime/*.test.cjs"
  }
}
